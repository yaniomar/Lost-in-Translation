PORT=5000
HOST=127.0.0.1
AWS_REGION=us-east-1
DEVFEST_AWS_ACCOUNT_ID=530702499288

# Optional locally. Required on Vercel. Use the pooled Neon connection string
# and keep it backend-only (never prefix it with VITE_).
# DATABASE_URL=postgresql://...

# Local live mode requires this explicit named profile. The default profile is
# intentionally never used when AWS_PROFILE is absent.
AWS_PROFILE=devfest-translate

MAX_TOTAL_AWS_REQUESTS=3000
MAX_TOTAL_TRANSLATED_CHARACTERS=300000
MAX_ATTEMPTS_PER_PLAYER=3
AWS_REQUEST_TIMEOUT_MS=8000

OFFLINE_MODE=auto
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
SENTENCE_BANK_RATE_LIMIT_WINDOW_MS=3600000
SENTENCE_BANK_RATE_LIMIT_MAX=20

# On Vercel, remove AWS_PROFILE and configure these as server-side environment
# variables. Never set both a profile and environment credentials. Never commit
# real values. AWS_SESSION_TOKEN is required for temporary credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
